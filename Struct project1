using namespace std;

struct Item {
    string name;
    string type;
    int damage;
    int price;
};

void Printing(vector<Item>& a) {
    for (auto i = a.begin(); i != a.end(); ++i) {
        cout << i->name << " " << i->type << " " << i->damage << " " << i->price << endl;
    }
}

void MostPricey(vector<Item>& a) {
    int mx = LLONG_MIN;
    string h;
    for (auto i = a.begin(); i != a.end(); ++i) {
        if (i->price > mx) {
            mx = i->price;
            h = i->name;
        }
    }

    cout << "MOST EXPENSIVE ITEM: " << h << endl << "PRICE: " << mx << endl;
}

void FindWeapon(string s, vector<Item>& a) {
    bool t = false;

    for (auto i = a.begin(); i != a.end(); ++i) {
        if (i->name == s && !t) {
            cout << "Found!" << endl << "Damage: " << i->damage << endl << "Price: " << i->price << endl;
            t = true;
        }
    }

    if (!t) {
        cout << "Not Found!" << endl;
    }
}

void AddDamage(string s, vector<Item>& a) {
    for (auto i = a.begin(); i != a.end(); ++i) {
        if (i->type == s) {
            cout << i->name << ": " << i->damage << " -> " << i->damage + 10 << endl;
            i->damage += 10;
        }
    }
}

void Deleting(vector<Item>& a) {
    for (auto i = a.begin(); i != a.end(); ++i) {
        if (i->price < 300) {
            i = a.erase(i);
        }
    }
}

void HowManyTypes(vector<Item>& a) {
    set<string> st;

    for (auto i = a.begin(); i != a.end(); ++i) {
        st.insert(i->type);
    }

    for (auto i = st.begin(); i != st.end(); i++) {
        cout << *i << endl;
    }
}

void HowManyCountTypes(vector<Item>& a) {
    map<string, int> st;

    for (auto i = a.begin(); i != a.end(); ++i) {
        st[i->type]++;
    }

    for (auto i = st.begin(); i != st.end(); i++) {
        cout << i->first << " " << i->second << endl;
    }
}

void ReversePrinting(vector<Item>& a) {
    for (auto i = a.rbegin(); i != a.rend(); ++i) {
        cout << i->name << endl;
    }
}

void BonusAdd(string s, vector<Item>& a) {
    bool t = false;
    for (auto i = a.begin(); i != a.end(); ++i) {
        if (i->name == s && !t) {
            cout << i->name << ": " << i->price << " -> " << i->price + 500 << endl;
            i->price += 500;
            t = true;
        }
    }

    if (!t) {
        cout << "Not Found!" << endl;
    }
}

